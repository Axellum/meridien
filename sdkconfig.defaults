# Reglages communs a toutes les cartes. Ce qui depend de la carte (flash, PSRAM, revision de puce,
# console, table de partitions) est dans boards/<carte>/sdkconfig.defaults.board (ADR-0005).
CONFIG_IDF_TARGET="esp32p4"

# La tache principale construit l'interface (TinyTTF, formats) : la pile par defaut (3584 octets) est trop juste.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Test de la PSRAM coupe au demarrage : il prenait 886 ms sur les ~2,0 s qui precedent la premiere lumiere de la 7B (mesure du
# 09/11/2026, commit c3fd97b), soit le meme test que le firmware ESPHome a coupe (CONFIG_SPIRAM_MEMTEST "n"). Contrepartie : la
# memoire n'est plus balayee a chaque demarrage. Apres ce changement : supprimer sdkconfig.
CONFIG_SPIRAM_MEMTEST=n

# Memoire interne (budget du jalon 1b, docs/mesures/memoire-interne.md) : le tas interne du P4 fait ~455 Ko, dont les tampons
# d'ecran. Tout ce qui n'est ni DMA ni pile de tache va en PSRAM. COMMUN a toutes les cartes (toutes ont une PSRAM, et la limite vient
# du Wi-Fi par le C6, du TLS et de l'interface, pas de la carte) ; avant le 11/11/2026 ces deux lignes n'etaient que dans le fichier
# du Tab5 et la 7B gardait les defauts d'IDF (16384, tampons TLS en interne).
#  - malloc() ne prend l'interne que jusqu'a 256 octets (defaut d'IDF : 16384) : 66 Ko libres de plus avant la premiere requete
#    TLS sur le Tab5 (177,6 Ko au lieu de 111,7 Ko) ;
#  - mbedTLS (tampons d'entree et de sortie, certificats) en PSRAM : environ 29 Ko de moins en interne pendant une prise de contact
#    TLS, de quoi en faire deux a la fois (meteo et geocodage). Prix mesure sur le Tab5 : prise de contact de 2,8 s au lieu de 1,5 s.
# Apres un changement de ces defaults : supprimer sdkconfig.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=256
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# LVGL 9 configure par Kconfig (pas de lv_conf.h). Chaines et formats : ceux de la libc d'IDF, comme le BSP d'Espressif
# (m5stack_tab5/examples). Allocation : celle de main/lvgl_memoire.cpp (PSRAM d'abord) et non le malloc du systeme, qui range tout
# bloc de moins de 256 octets en memoire interne (CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL ci-dessus), la seule ou le Wi-Fi et le TLS
# peuvent vivre (plantage du scan Wi-Fi, 07/11/2026).
# Apres un changement de ces defaults : supprimer sdkconfig (les defaults ne sont relus que sur un sdkconfig neuf).
CONFIG_LV_CONF_SKIP=y
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_USE_CUSTOM_MALLOC=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_USE_CLIB_STRING=y

# Polices TrueType rendues a la volee (Latin-1 complet : accents et degre). Les polices integrees de LVGL
# s'arretent a l'ASCII ; une police sans le "e accent aigu" afficherait un rectangle vide.
CONFIG_LV_USE_TINY_TTF=y
CONFIG_LV_TINY_TTF_FILE_SUPPORT=n

# Boucle d'evenements du systeme (tache sys_evt, pile par defaut 2304 octets) : elle execute les gestionnaires Wi-Fi/IP de
# main/reseau.cpp, dont l'essai d'un nouveau reseau avec retour arriere (esp_wifi_set_config / disconnect / scan par RPC vers le
# C6, structures de ~130 octets sur la pile). Valeur de depart ; la marge mesuree est dans docs/mesures/wifi-retour-arriere.md.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# Heure reseau (jalon 1b) : deux serveurs SNTP (celui par defaut d'IDF n'en prend qu'un).
CONFIG_LWIP_SNTP_MAX_SERVERS=2

# Serveur de la page de reglages (jalon « reglages »). Les en-tetes d'un navigateur de telephone (agent, langues, referent,
# jeton) depassent les 512 octets par defaut -> la requete serait refusee (431). L'adresse de la recherche de ville peut
# atteindre ~1 Ko une fois les accents encodes.
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=1024

# Outil de mesure PROVISOIRE (commande serie " piles ", jalon 1b) : liste des taches avec la base et la marge de leur pile.
# A retirer avec la commande avant la phase 2.
CONFIG_FREERTOS_USE_TRACE_FACILITY=y

# Code compile pour la vitesse (-O2). Le defaut d'IDF est -Og (« debug ») : il laisse le calcul de l'interface deux fois plus lent.
# Essai du 08/11/2026 sur le Tab5 ST7121 de developpement (commit 1324550, 5 demarrages par binaire) : boucle de rotation du
# processeur 649 -> 307 µs, premiere image 379 -> 340 ms au maximum, PPA inchange. Les assertions RESTENT activees
# (CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_ENABLE) : spi_flash/cache_utils.c fait assert sur la pile (docs/mesures/memoire-interne.md).
# Apres un changement de ces defaults : supprimer sdkconfig (les defaults ne sont relus que sur un sdkconfig neuf).
CONFIG_COMPILER_OPTIMIZATION_PERF=y
